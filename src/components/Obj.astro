---
// Objet décoratif de parallaxe. Si le PNG manque, une forme CSS le remplace :
// il suffit ensuite de déposer src/assets/parallax/<name>.png.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  layer?: 'fond' | 'milieu' | 'avant';
  /** Largeur d'affichage maximale, en px (dimensionne les variantes d'image). */
  width?: number;
  speed?: number;
  desktopOnly?: boolean;
  eager?: boolean;
  style?: string;
}

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/parallax/*.png', {
  eager: true,
});
const speeds = { fond: 0.2, milieu: 0.5, avant: 0.9 };

const { name, layer = 'milieu', width = 240, speed, desktopOnly = false, eager = false, style } = Astro.props;
const file = files[`/src/assets/parallax/${name}.png`]?.default;
const widths = file ? [width, width * 2].filter((w) => w <= file.width) : [];
if (file && widths.length === 0) widths.push(file.width);
const delai = `${-(name.length * 1.3).toFixed(1)}s`;
---

<div
  class:list={['obj', `obj--${layer}`, { 'obj--desktop': desktopOnly }]}
  data-speed={speed ?? speeds[layer]}
  style={style}
  aria-hidden="true"
>
  <div class="obj__float" style={`--delai:${delai}`}>
    {file ? (
      <Picture
        src={file}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={widths}
        sizes={`(max-width: 899px) 40vw, ${width}px`}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <span class="obj__placeholder"></span>
    )}
  </div>
</div>
