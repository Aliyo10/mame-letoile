---
// Seul fichier à toucher pour le logo : déposer le fichier dans src/assets/logo/ sous le nom
// logo.png (ou .webp / .svg). Tant qu'il n'y en a pas, le wordmark de secours s'affiche.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logo/logo.{png,webp,svg}', {
  eager: true,
});
const logo = Object.values(files)[0]?.default;

interface Props {
  /** Largeur d'affichage du logo, en px. */
  size?: number;
}
const { size = 76 } = Astro.props;
---

{logo ? (
  <Image
    src={logo}
    alt={site.name}
    width={size}
    densities={[1, 2]}
    format="webp"
    class="logo-img"
    style={`width:${size}px`}
    loading="eager"
  />
) : (
  <span class="logo-word">
    <svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
      <path fill="#B08D57" d="M16 2.5l4 9.2 10 .9-7.6 6.6 2.3 9.8L16 23.8 7.3 29l2.3-9.8L2 12.6l10-.9z" />
    </svg>
    <span>L'Étoile</span>
    <span class="sr-only">, Maison d'Assistantes Maternelles</span>
  </span>
)}

<style>
  .logo-word {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-titre);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--encre);
  }
  .logo-img {
    height: auto;
  }
</style>
