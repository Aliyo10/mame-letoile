---
import { Picture } from 'astro:assets';
import Obj from './Obj.astro';
import { url } from '../lib/url';
import { duo } from '../data/site';
import cubeM from '../assets/parallax/cube-M.png';
import cubeA from '../assets/parallax/cube-A.png';
import cubeEAccent from '../assets/parallax/cube-E-accent.png';
import cubeT from '../assets/parallax/cube-T.png';
import cubeO from '../assets/parallax/cube-O.png';
import cubeI from '../assets/parallax/cube-I.png';
import cubeL from '../assets/parallax/cube-L.png';
import cubeE from '../assets/parallax/cube-E.png';
import etoile from '../assets/parallax/etoile.png';

// sx, sy : position éparpillée en vw / vh depuis le centre de l'écran.
// s : profondeur apparente, m : amplitude du suivi de souris.
const rows = [
  [
    { src: cubeM, sx: -41, sy: -14, r: -16, s: 1.3, m: 1 },
    { src: cubeA, sx: -26, sy: -34, r: 16, s: 0.8, m: 0.4 },
    { src: cubeM, sx: 7, sy: -36, r: -12, s: 0.62, m: 0.25 },
    { src: cubeE, sx: 28, sy: -31, r: 20, s: 0.9, m: 0.55 },
  ],
  [
    { src: cubeEAccent, sx: -41, sy: 18, r: 12, s: 1.1, m: 0.85 },
    { src: cubeT, sx: -23, sy: 36, r: -14, s: 0.82, m: 0.5 },
    { src: cubeO, sx: 3, sy: 39, r: 22, s: 0.62, m: 0.3 },
    { src: cubeI, sx: 25, sy: 35, r: -18, s: 0.85, m: 0.55 },
    { src: cubeL, sx: 41, sy: 17, r: 15, s: 1.3, m: 1 },
    { src: cubeE, sx: 43, sy: -13, r: -22, s: 0.95, m: 0.65 },
  ],
];
---

<section class="hero" data-hero>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__layer" data-mouse="0.2">
      <Obj name="lune" layer="fond" width={130} desktopOnly style="--w:7vw; right:3%; bottom:4%" />
      <Obj name="anneau" layer="fond" width={90} desktopOnly style="--w:5vw; left:14%; top:10%" />
    </div>
    <div class="hero__layer" data-mouse="0.5">
      <Obj name="sphere-bois" layer="milieu" width={130} desktopOnly style="--w:6vw; left:3%; bottom:6%" />
    </div>

    <div class="hero__copy" data-hero-copy>
      <span class="eyebrow" data-hero-intro>Maison d'assistantes maternelles</span>
      <h1 data-hero-intro>Un cocon pour grandir, <em>au cœur de Valence</em></h1>
      <p class="lead" data-hero-intro>
        {duo} accueillent vos enfants dans un environnement chaleureux, ludique et sécurisé.
      </p>
      <div class="hero__actions" data-hero-intro>
        <a class="btn btn--primaire" href={url('contact.html')}>Demander une place</a>
        <a class="lien" href={url('presentation.html')}>Découvrir la maison</a>
      </div>
    </div>

    <div class="hero__word" data-hero-word aria-hidden="true">
      <div class="hero__star" data-hero-star>
        <Picture src={etoile} formats={['avif', 'webp']} fallbackFormat="webp" widths={[120, 240]} sizes="120px" alt="" loading="eager" />
      </div>
      {rows.map((row, r) => (
        <div class="hero__cubes">
          {row.map((cube, i) => (
            <div class="cube" data-cube data-sx={cube.sx} data-sy={cube.sy} data-r={cube.r} data-s={cube.s}>
              <div data-mouse={cube.m}>
                <div class="obj__float" style={`--delai:${-(r * 4 + i) * 1.7}s; --duree:${6 + (i % 3)}s`}>
                  <Picture
                    src={cube.src}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[120, 240, 400]}
                    sizes="(min-width: 900px) 10vw, 15vw"
                    alt=""
                    loading="eager"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <p class="hero__after lead" data-hero-after>Un lieu de bienveillance et de découverte, à Valence.</p>
  </div>
</section>

<style>
  /* État de base : mobile et prefers-reduced-motion, cubes déjà alignés. */
  .hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(36px, 6vh, 64px);
    min-height: 100svh;
    padding: calc(var(--header-h) + 16px) var(--gutter) 48px;
    text-align: center;
    overflow: clip;
  }
  .hero__layer {
    display: none;
    position: absolute;
    inset: 0;
  }
  :global(html.motion-hero) .hero__layer { display: block; }
  .hero__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .hero__copy h1 { max-width: 12em; }
  .hero__copy h1 em { display: block; }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }
  .hero__word {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }
  .hero__star {
    width: clamp(56px, 7.4vw, 112px);
    margin-bottom: clamp(6px, 1vw, 14px);
  }
  .hero__star :global(img), .cube :global(img) { filter: var(--ombre); }
  .hero__cubes {
    display: flex;
    gap: clamp(3px, 0.7vw, 12px);
    margin-top: clamp(3px, 0.7vw, 12px);
    --float: 0.3; /* le mot reste lisible : flottaison discrète quand les cubes sont alignés */
  }
  :global(html.motion-hero) .hero__cubes { --float: inherit; }
  .cube { width: min(14.4vw, 112px); }
  .hero__after { display: none; }
  @media (max-width: 899px) {
    .hero__stage {
      gap: 22px;
      padding-top: var(--header-h);
      padding-bottom: 24px;
    }
    .hero__copy { gap: 0.9rem; }
    .hero__actions { margin-top: 0.25rem; gap: 0.25rem 2rem; }
  }

  /* Hero épinglé sur desktop : classe posée avant le premier rendu. */
  :global(html.motion-hero) .hero__stage {
    display: block;
    height: 100vh;
    min-height: 620px;
    padding: 0;
  }
  :global(html.motion-hero) .hero__copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    justify-content: center;
    padding: var(--header-h) var(--gutter) 0;
  }
  :global(html.motion-hero) .hero__word {
    position: absolute;
    inset: 0;
    z-index: 3;
    justify-content: center;
    padding-top: var(--header-h);
  }
  :global(html.motion-hero) .hero__word:not(.is-ready) { visibility: hidden; }
  :global(html.motion-hero) .cube { width: min(9.6vw, 15vh, 140px); }
  :global(html.motion-hero) .hero__after {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 9vh;
    margin-inline: auto;
    visibility: hidden;
  }
</style>
